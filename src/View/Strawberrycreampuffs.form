                  <Font name="Arial" size="12" style="0"/>
                </Property>
                <Property name="rows" type="int" value="5"/>
                <Property name="text" type="java.lang.String" value="Indredienta&#xa;&#xa;1. All-purpose flour&#xa;&#xa;2. Unsalted butter&#xa;&#xa;3. Water&#xa;&#xa;4. Salt&#xa;&#xa;5. Eggs&#xa;&#xa;6. Heavy whipping cream&#xa;&#xa;Powdered sugar&#xa;&#xa;7. Granulated sugar&#xa;&#xa;8. Vanilla extract&#xa;&#xa;9. Fresh strawberries&#xa;&#xa;10. Lemon juice (optional, for strawberry freshness)&#xa;&#xa;11. Cornstarch (optional, for thickening strawberry sauce)&#xa;&#xa;12. Cream cheese (optional, for richer filling)&#xa;&#xa;13. Milk (optional, for glaze or dough)&#xa;&#xa;14. Chocolate (optional, for drizzling)&#xa;&#xa;15. Egg yolk (for egg wash)&#xa;"/>
              </Properties>
            </Component>
          </SubComponents>
