          <SubComponents>
            <Component class="javax.swing.JTextArea" name="jTextArea1">
              <Properties>
                <Property name="columns" type="int" value="20"/>
                <Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor">
                  <Font name="Arial" size="12" style="0"/>
                </Property>
                <Property name="rows" type="int" value="5"/>
                <Property name="text" type="java.lang.String" value="Ingredients:&#xa;&#xa;1. 200g dark chocolate&#xa;&#xa;2. 200ml heavy cream &#xa;(for ganache) &#xa;&#xa;3. 250g mascarpone&#xa; cheese &#xa;&#xa;4. 200ml cold whipping&#xa; cream &#xa;&#xa;5. 3 tbsp powdered sugar&#xa;&#xa;6.1 tsp vanilla extract &#xa;&#xa;7. 1 cup strong coffee &#xa;(cooled) &#xa;&#xa;8. 2 tbsp coffee liqueur &#xa;(optional)&#xa;&#xa;9. 200g ladyfinger biscuits &#xa;Cocoa powder (for dusting)"/>
              </Properties>
            </Component>
          </SubComponents>
        </Container>
        <Container class="javax.swing.JScrollPane" name="jScrollPane2">
          <AuxValues>
            <AuxValue name="autoScrollPane" type="java.lang.Boolean" value="true"/>
          </AuxValues>

          <Layout class="org.netbeans.modules.form.compat2.layouts.support.JScrollPaneSupportLayout"/>
          <SubComponents>
            <Component class="javax.swing.JTextArea" name="jTextArea2">
              <Properties>
                <Property name="columns" type="int" value="20"/>
                <Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor">
                  <Font name="Arial" size="12" style="0"/>
                </Property>
                <Property name="rows" type="int" value="5"/>
                <Property name="text" type="java.lang.String" value="Directions&#xa;&#xa;1.Heat cream, pour over&#xa;chocolate,stir to make ganache.&#xa;&#xa;2. Whip cream with sugar &#xa;and vanilla, fold into&#xa;mascarpone.&#xa;&#xa;3.Mix coffee with liqueur&#xa; (optional).&#xa;&#xa;4.Dip ladyfingers in coffe,&#xa; layer in dish.&#xa;&#xa;5.Add mascarpone mixture, &#xa;then ganache. Repeat layers.&#xa;&#xa;6.Chill for 4+ hours.&#xa;&#xa;7.Dust with cocoa before&#xa; serving"/>
              </Properties>
            </Component>
          </SubComponents>
        </Container>
